<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{A1F5550B-5D96-46CF-BBC5-3EAC4412E293}</ProjectGuid>
    <RootNamespace>CurveBrowserShell</RootNamespace>
    <ApplicationType>Windows Store</ApplicationType>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22000.0</WindowsTargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The shell is deliberately an in-process DLL. It carries the same
         reg-free runtime initializer and payload as a self-contained EXE. -->
    <WindowsAppSDKSelfContainedAudit>false</WindowsAppSDKSelfContainedAudit>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)out\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)out\obj\$(Configuration)\$(Platform)\</IntDir>
    <TargetName>curve_browser_shell</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>WINDOWS_CHROMIUM_SHELL_IMPLEMENTATION;WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/permissive- /Zc:preprocessor /utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>comctl32.lib;dwmapi.lib;gdi32.lib;runtimeobject.lib;user32.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>Microsoft.UI.Windowing.Core.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
      <SubType>Code</SubType>
    </ClInclude>
    <ClInclude Include="pch.h" />
    <ClInclude Include="shell.h" />
    <ClInclude Include="windows_chromium_shell_api.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
      <SubType>Code</SubType>
    </ClCompile>
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="shell.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="App.idl">
      <DependentUpon>App.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Midl>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.250303.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
  </ItemGroup>
  <Target Name="WriteCurveBrowserPayloadManifest" AfterTargets="Build">
    <ItemGroup>
      <CurveBrowserTopLevelPayload Include="$(OutDir)*.dll;$(OutDir)*.pri;$(OutDir)*.xbf;$(OutDir)*.winmd;$(OutDir)App.xaml;$(OutDir)RestartAgent.exe" />
      <CurveBrowserTopLevelPayload Remove="$(OutDir)CurveBrowserShellPreview.*;$(OutDir)WindowsChromiumShellPreview.*;$(OutDir)windows_chromium_shell.*" />
      <CurveBrowserMuiPayload Include="$(OutDir)**\*.mui" />
      <CurveBrowserAssetPayload Include="$(OutDir)Microsoft.UI.Xaml\Assets\*" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(OutDir)curve_browser_payload_manifest.txt"
        Lines="@(CurveBrowserTopLevelPayload->'%(Filename)%(Extension)');@(CurveBrowserMuiPayload->'%(RecursiveDir)%(Filename)%(Extension)');@(CurveBrowserAssetPayload->'Microsoft.UI.Xaml\Assets\%(Filename)%(Extension)')"
        Overwrite="true"
        Encoding="UTF-8" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
