description: keep Curve Browser portable profiles beside the application
author: Curve Browser Authors

---
 chrome/install_static/user_data_dir.cc | 58 ++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

--- a/chrome/install_static/user_data_dir.cc
+++ b/chrome/install_static/user_data_dir.cc
@@ -54,6 +54,58 @@ std::wstring MakeAbsoluteFilePath(const std::wstring& input) {
   return file_path;
 }
 
+// Reads the portable profile location from portable.ini beside chrome.exe.
+// An explicit command-line directory, enterprise policy, and the dedicated
+// headless profile all take precedence over this portable default.
+bool GetPortableUserDataDirectory(std::wstring* result) {
+  assert(result);
+  wchar_t module_path[32768] = {};
+  const DWORD module_path_length =
+      ::GetModuleFileNameW(nullptr, module_path, _countof(module_path));
+  if (!module_path_length || module_path_length >= _countof(module_path)) {
+    return false;
+  }
+
+  std::wstring application_directory(module_path, module_path_length);
+  const size_t separator = application_directory.find_last_of(L"\\/");
+  if (separator == std::wstring::npos) {
+    return false;
+  }
+  application_directory.resize(separator + 1);
+  const std::wstring configuration_path =
+      application_directory + L"portable.ini";
+  const DWORD attributes = ::GetFileAttributesW(configuration_path.c_str());
+  if (attributes == INVALID_FILE_ATTRIBUTES ||
+      (attributes & FILE_ATTRIBUTE_DIRECTORY)) {
+    return false;
+  }
+
+  wchar_t configured_path[32768] = {};
+  const DWORD configured_path_length = ::GetPrivateProfileStringW(
+      L"CurveBrowser", L"UserDataDirectory", L"", configured_path,
+      _countof(configured_path), configuration_path.c_str());
+  if (!configured_path_length ||
+      configured_path_length >= _countof(configured_path) - 1) {
+    return false;
+  }
+
+  std::wstring expanded_path = ExpandPathVariables(
+      std::wstring(configured_path, configured_path_length));
+  if (expanded_path.empty()) {
+    return false;
+  }
+  const bool has_drive =
+      expanded_path.size() >= 2 && expanded_path[1] == L':';
+  const bool has_root = !expanded_path.empty() &&
+                        (expanded_path[0] == L'\\' ||
+                         expanded_path[0] == L'/');
+  if (!has_drive && !has_root) {
+    expanded_path.insert(0, application_directory);
+  }
+  *result = MakeAbsoluteFilePath(expanded_path);
+  return !result->empty();
+}
+
 // The same as GetUserDataDirectory(), but directly queries the global command
 // line object for the --user-data-dir flag. This is the more commonly used
 // function, where GetUserDataDirectory() is used primarily for testing.
@@ -135,6 +187,12 @@ bool GetUserDataDirectoryImpl(const std::wstring& command_line,
     }
   }
 
+  // A portable distribution opts into an application-local profile without
+  // changing installed builds or overriding an explicit/policy/headless path.
+  if (user_data_dir.empty()) {
+    GetPortableUserDataDirectory(&user_data_dir);
+  }
+
