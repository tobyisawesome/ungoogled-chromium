+// Copyright 2026 The Curve Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_CURVE_BROWSER_NATIVE_SHELL_HOST_WIN_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_CURVE_BROWSER_NATIVE_SHELL_HOST_WIN_H_
+
+#include <windows.h>
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/frame/curve_browser_shell_api_win.h"
+
+class Browser;
+class BrowserView;
+class GURL;
+
+// Owns the optional in-process WinUI 3 shell for one normal browser window.
+// The DLL boundary intentionally contains no WinRT or WinUI types so Chromium
+// remains buildable and launchable without the Windows App SDK payload.
+class CurveBrowserNativeShellHostWin {
+ public:
+  CurveBrowserNativeShellHostWin(BrowserView* browser_view, Browser* browser);
+  CurveBrowserNativeShellHostWin(const CurveBrowserNativeShellHostWin&) =
+      delete;
+  CurveBrowserNativeShellHostWin& operator=(
+      const CurveBrowserNativeShellHostWin&) = delete;
+  ~CurveBrowserNativeShellHostWin();
+
+  bool Initialize();
+  bool is_active() const { return shell_ != nullptr; }
+  void SyncState();
+  void SetVisible(bool visible);
+  void ShowFind();
+
+ private:
+  using GetApiVersionFn = uint32_t(__stdcall*)();
+  using CreateShellFn = HRESULT(__stdcall*)(HWND,
+                                            const WcsHostCallbacks*,
+                                            WcsShellHandle*);
+  using DestroyShellFn = void(__stdcall*)(WcsShellHandle);
+  using UpdateWindowStateFn = HRESULT(__stdcall*)(WcsShellHandle,
+                                                  const WcsWindowState*);
+  using SetVisibleFn = void(__stdcall*)(WcsShellHandle, BOOL);
+  using ShowFindFn = void(__stdcall*)(WcsShellHandle);
+
+  static void __stdcall InvokeCommandThunk(void* context,
+                                           const WcsCommandArgs* args);
+  void PostCommand(const WcsCommandArgs& args);
+  void InvokeCommand(WcsCommand command,
+                     int64_t tab_id,
+                     int32_t tab_index,
+                     std::wstring text,
+                     uint32_t event_flags);
+  int ResolveTabIndex(int64_t tab_id, int32_t tab_index) const;
+  void ExecuteBrowserCommand(int command_id);
+  void NavigateFromOmnibox(const std::wstring& text);
+  void OpenInternalPage(const GURL& url);
+  void Unload();
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<Browser> browser_;
+  HMODULE module_ = nullptr;
+  WcsShellHandle shell_ = nullptr;
+  DestroyShellFn destroy_shell_ = nullptr;
+  UpdateWindowStateFn update_window_state_ = nullptr;
+  SetVisibleFn set_visible_ = nullptr;
+  ShowFindFn show_find_ = nullptr;
+  base::WeakPtrFactory<CurveBrowserNativeShellHostWin> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_CURVE_BROWSER_NATIVE_SHELL_HOST_WIN_H_
