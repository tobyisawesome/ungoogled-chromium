+namespace {
+
+constexpr wchar_t kShellDllName[] = L"curve_browser_shell.dll";
+constexpr wchar_t kWindowsAppRuntimeDllName[] =
+    L"Microsoft.WindowsAppRuntime.dll";
+constexpr char kDisableShellSwitch[] = "disable-curve-browser-shell";
+constexpr char kShellPathSwitch[] = "curve-browser-shell-path";
+
+template <typename Function>
+Function ResolveExport(HMODULE module, const char* name) {
+  return reinterpret_cast<Function>(GetProcAddress(module, name));
+}
+
+bool EnsureSelfContainedRuntimeLoaded(const base::FilePath& directory) {
+  static HMODULE runtime_module = nullptr;
+  if (runtime_module) {
+    return true;
+  }
+
+  const base::FilePath runtime_path =
+      directory.Append(kWindowsAppRuntimeDllName);
+  HMODULE module = LoadLibraryExW(runtime_path.value().c_str(), nullptr,
+                                  LOAD_WITH_ALTERED_SEARCH_PATH);
+  if (!module) {
+    return false;
+  }
+  using EnsureIsLoadedFn = HRESULT(STDAPICALLTYPE*)();
+  const auto ensure_is_loaded = ResolveExport<EnsureIsLoadedFn>(
+      module, "WindowsAppRuntime_EnsureIsLoaded");
+  if (!ensure_is_loaded || FAILED(ensure_is_loaded())) {
+    FreeLibrary(module);
+    return false;
+  }
+  runtime_module = module;
+  return true;
+}
+
+uint32_t UserCloseTypes() {
+  return CLOSE_USER_GESTURE | CLOSE_CREATE_HISTORICAL_TAB;
+}
+
+}  // namespace
+
+CurveBrowserNativeShellHostWin::CurveBrowserNativeShellHostWin(
+    BrowserView* browser_view,
+    Browser* browser)
+    : browser_view_(browser_view), browser_(browser) {}
+
+CurveBrowserNativeShellHostWin::~CurveBrowserNativeShellHostWin() {
+  Unload();
+}
+
+bool CurveBrowserNativeShellHostWin::Initialize() {
+  if (!browser_ || !browser_view_ || !browser_->is_type_normal() ||
+      base::CommandLine::ForCurrentProcess()->HasSwitch(kDisableShellSwitch)) {
+    return false;
+  }
+
+  base::FilePath shell_path =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kShellPathSwitch);
+  if (shell_path.empty()) {
+    base::FilePath executable_directory;
+    if (!base::PathService::Get(base::DIR_EXE, &executable_directory)) {
+      return false;
+    }
+    shell_path = executable_directory.Append(kShellDllName);
+  }
+
+  if (!EnsureSelfContainedRuntimeLoaded(shell_path.DirName())) {
+    return false;
+  }
+
+  module_ = LoadLibraryExW(shell_path.value().c_str(), nullptr,
+                           LOAD_WITH_ALTERED_SEARCH_PATH);
+  if (!module_) {
+    return false;
+  }
+
+  const auto get_api_version =
+      ResolveExport<GetApiVersionFn>(module_, "WcsGetApiVersion");
+  const auto create_shell =
+      ResolveExport<CreateShellFn>(module_, "WcsCreateShell");
+  destroy_shell_ = ResolveExport<DestroyShellFn>(module_, "WcsDestroyShell");
+  update_window_state_ =
+      ResolveExport<UpdateWindowStateFn>(module_, "WcsUpdateWindowState");
+  set_visible_ = ResolveExport<SetVisibleFn>(module_, "WcsSetVisible");
+  if (!get_api_version || get_api_version() != WCS_API_VERSION ||
+      !create_shell || !destroy_shell_ || !update_window_state_ ||
+      !set_visible_) {
+    Unload();
+    return false;
+  }
+
+  HWND parent = views::HWNDForWidget(browser_view_->GetWidget());
+  if (!parent) {
+    Unload();
+    return false;
+  }
+
+  const WcsHostCallbacks callbacks{sizeof(WcsHostCallbacks), WCS_API_VERSION,
+                                   this, &InvokeCommandThunk};
+  if (FAILED(create_shell(parent, &callbacks, &shell_)) || !shell_) {
+    Unload();
+    return false;
+  }
+
+  SyncState();
+  return true;
+}
+
+void CurveBrowserNativeShellHostWin::Unload() {
+  if (shell_ && destroy_shell_) {
+    destroy_shell_(shell_);
+  }
+  shell_ = nullptr;
+  destroy_shell_ = nullptr;
+  update_window_state_ = nullptr;
+  set_visible_ = nullptr;
+  if (module_) {
+    FreeLibrary(module_);
+    module_ = nullptr;
+  }
+}
+
+void CurveBrowserNativeShellHostWin::SyncState() {
+  if (!shell_ || !update_window_state_ || !browser_) {
+    return;
+  }
+
+  TabStripModel* model = browser_->tab_strip_model();
+  if (!model) {
+    return;
+  }
+
+  std::vector<std::wstring> titles;
+  std::vector<std::wstring> urls;
+  std::vector<WcsTabState> tabs;
+  titles.reserve(model->count());
+  urls.reserve(model->count());
+  tabs.reserve(model->count());
+
+  for (int index = 0; index < model->count(); ++index) {
+    content::WebContents* contents = model->GetWebContentsAt(index);
+    titles.push_back(contents ? base::UTF16ToWide(contents->GetTitle())
+                              : std::wstring());
+    urls.push_back(contents ? base::UTF8ToWide(contents->GetVisibleURL().spec())
+                            : std::wstring());
+    const int64_t tab_id =
+        contents ? sessions::SessionTabHelper::IdForTab(contents).id() : -1;
+    tabs.push_back(WcsTabState{
+        sizeof(WcsTabState), tab_id, index, titles.back().c_str(),
+        urls.back().c_str(), index == model->active_index(),
+        model->IsTabPinned(index), contents && contents->IsLoading(), 0,
+        contents && contents->IsAudioMuted()});
+  }
+
+  content::WebContents* active_contents = model->GetActiveWebContents();
+  std::wstring profile_name =
+      base::UTF8ToWide(browser_->profile()->GetProfileUserName());
+  if (profile_name.empty()) {
+    profile_name = L"Local profile";
+  }
+  const SessionStartupPref startup_pref =
+      SessionStartupPref::GetStartupPref(browser_->profile());
+  const WcsWindowState state{
+      sizeof(WcsWindowState),
+      tabs.data(),
+      tabs.size(),
+      model->active_index(),
+      active_contents && active_contents->GetController().CanGoBack(),
+      active_contents && active_contents->GetController().CanGoForward(),
+      browser_->profile()->IsOffTheRecord(),
+      profile_name.c_str(),
+      startup_pref.ShouldRestoreLastSession(),
+  };
+  update_window_state_(shell_, &state);
+}
+
+void CurveBrowserNativeShellHostWin::SetVisible(bool visible) {
+  if (shell_ && set_visible_) {
+    set_visible_(shell_, visible ? TRUE : FALSE);
+  }
+}
+
+// static
+void __stdcall CurveBrowserNativeShellHostWin::InvokeCommandThunk(
+    void* context,
+    const WcsCommandArgs* args) {
+  if (context && args && args->size >= sizeof(WcsCommandArgs)) {
+    static_cast<CurveBrowserNativeShellHostWin*>(context)->PostCommand(*args);
+  }
+}
+
+void CurveBrowserNativeShellHostWin::PostCommand(const WcsCommandArgs& args) {
+  // XAML invokes callbacks while dispatching its own routed event. Defer the
+  // Chromium mutation to avoid re-entering TabView when closing a tab or
+  // tearing down the window. Copy text because the ABI pointer is valid only
+  // for the duration of the callback.
+  std::wstring text = args.text ? args.text : L"";
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&CurveBrowserNativeShellHostWin::InvokeCommand,
+                     weak_ptr_factory_.GetWeakPtr(), args.command, args.tab_id,
+                     args.tab_index, std::move(text), args.event_flags));
+}
+
+int CurveBrowserNativeShellHostWin::ResolveTabIndex(int64_t tab_id,
+                                                    int32_t tab_index) const {
+  TabStripModel* model = browser_ ? browser_->tab_strip_model() : nullptr;
+  if (!model) {
+    return TabStripModel::kNoTab;
+  }
+  if (tab_index >= 0 && tab_index < model->count()) {
+    content::WebContents* candidate = model->GetWebContentsAt(tab_index);
+    if (tab_id < 0 ||
+        sessions::SessionTabHelper::IdForTab(candidate).id() == tab_id) {
+      return tab_index;
+    }
+  }
+  for (int index = 0; index < model->count(); ++index) {
+    if (sessions::SessionTabHelper::IdForTab(model->GetWebContentsAt(index))
+            .id() == tab_id) {
+      return index;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+void CurveBrowserNativeShellHostWin::ExecuteBrowserCommand(int command_id) {
+  chrome::ExecuteCommandWithDisposition(browser_, command_id,
+                                        WindowOpenDisposition::CURRENT_TAB);
+}
+
+void CurveBrowserNativeShellHostWin::NavigateFromOmnibox(
+    const std::wstring& text) {
+  LocationBarView* location_bar = browser_view_->GetLocationBarView();
+  OmniboxView* omnibox = location_bar ? location_bar->GetOmniboxView() : nullptr;
+  if (!omnibox) {
+    return;
+  }
+
+  // Reuse Chromium's real omnibox model even though the Views toolbar is
+  // hidden. This preserves URL fixup, the configured search provider,
+  // keyword-mode behavior, security checks, and navigation metrics for input
+  // submitted by the native WinUI TextBox.
+  omnibox->SetUserText(base::WideToUTF16(text));
+  ExecuteBrowserCommand(IDC_OPEN_CURRENT_URL);
+}
+
+void CurveBrowserNativeShellHostWin::OpenInternalPage(const GURL& url) {
+  content::OpenURLParams params(url, content::Referrer(),
+                                WindowOpenDisposition::CURRENT_TAB,
+                                ui::PAGE_TRANSITION_AUTO_BOOKMARK, false);
+  browser_->OpenURL(params, {});
+}
+
+void CurveBrowserNativeShellHostWin::InvokeCommand(
+    WcsCommand command,
+    int64_t tab_id,
+    int32_t tab_index,
+    std::wstring text,
+    uint32_t event_flags) {
+  if (!browser_) {
+    return;
+  }
+  TabStripModel* model = browser_->tab_strip_model();
+  tab_index = ResolveTabIndex(tab_id, tab_index);
+
+  switch (command) {
+    case WCS_COMMAND_NEW_TAB:
+      ExecuteBrowserCommand(IDC_NEW_TAB);
+      break;
+    case WCS_COMMAND_ACTIVATE_TAB:
+      if (tab_index != TabStripModel::kNoTab) {
+        model->ActivateTabAt(tab_index);
+      }
+      break;
+    case WCS_COMMAND_CLOSE_TAB:
+      if (tab_index != TabStripModel::kNoTab) {
+        model->CloseWebContentsAt(tab_index, UserCloseTypes());
+      }
+      break;
+    case WCS_COMMAND_DUPLICATE_TAB:
+      if (tab_index != TabStripModel::kNoTab) {
+        chrome::DuplicateTabAt(browser_, tab_index);
+      }
+      break;
+    case WCS_COMMAND_TOGGLE_PIN_TAB:
+      if (tab_index != TabStripModel::kNoTab) {
+        model->SetTabPinned(tab_index, !model->IsTabPinned(tab_index));
+      }
+      break;
+    case WCS_COMMAND_CLOSE_OTHER_TABS:
+      if (tab_index != TabStripModel::kNoTab) {
+        for (int index = model->count() - 1; index >= 0; --index) {
+          if (index != tab_index) {
+            model->CloseWebContentsAt(index, UserCloseTypes());
+          }
+        }
+      }
+      break;
+    case WCS_COMMAND_CLOSE_TABS_TO_RIGHT:
+      if (tab_index != TabStripModel::kNoTab) {
+        for (int index = model->count() - 1; index > tab_index; --index) {
+          model->CloseWebContentsAt(index, UserCloseTypes());
+        }
+      }
+      break;
+    case WCS_COMMAND_BACK:
+      ExecuteBrowserCommand(IDC_BACK);
+      break;
+    case WCS_COMMAND_FORWARD:
+      ExecuteBrowserCommand(IDC_FORWARD);
+      break;
+    case WCS_COMMAND_RELOAD:
+      if (tab_id >= 0 && tab_index != TabStripModel::kNoTab) {
+        model->GetWebContentsAt(tab_index)->GetController().Reload(
+            content::ReloadType::NORMAL, true);
+      } else {
+        ExecuteBrowserCommand(IDC_RELOAD);
+      }
+      break;
+    case WCS_COMMAND_STOP:
+      ExecuteBrowserCommand(IDC_STOP);
+      break;
+    case WCS_COMMAND_NAVIGATE:
+      if (!text.empty()) {
+        NavigateFromOmnibox(text);
+      }
+      break;
+    case WCS_COMMAND_HOME:
+      ExecuteBrowserCommand(IDC_HOME);
+      break;
+    case WCS_COMMAND_OPEN_HISTORY:
+      ExecuteBrowserCommand(IDC_SHOW_HISTORY);
+      break;
+    case WCS_COMMAND_OPEN_DOWNLOADS:
+      ExecuteBrowserCommand(IDC_SHOW_DOWNLOADS);
+      break;
+    case WCS_COMMAND_OPEN_BOOKMARKS:
+      ExecuteBrowserCommand(IDC_SHOW_BOOKMARK_MANAGER);
+      break;
+    case WCS_COMMAND_OPEN_EXTENSIONS:
+      ExecuteBrowserCommand(IDC_MANAGE_EXTENSIONS);
+      break;
+    case WCS_COMMAND_OPEN_PASSWORDS:
+      ExecuteBrowserCommand(IDC_SHOW_PASSWORD_MANAGER);
+      break;
+    case WCS_COMMAND_OPEN_SETTINGS:
+      ExecuteBrowserCommand(IDC_OPTIONS);
+      break;
+    case WCS_COMMAND_OPEN_PROFILES:
+      OpenInternalPage(GURL("chrome://settings/manageProfile"));
+      break;
+    case WCS_COMMAND_NEW_WINDOW:
+      ExecuteBrowserCommand(IDC_NEW_WINDOW);
+      break;
+    case WCS_COMMAND_NEW_INCOGNITO_WINDOW:
+      ExecuteBrowserCommand(IDC_NEW_INCOGNITO_WINDOW);
+      break;
+    case WCS_COMMAND_FIND:
+      ExecuteBrowserCommand(IDC_FIND);
+      break;
+    case WCS_COMMAND_PRINT:
+      ExecuteBrowserCommand(IDC_PRINT);
+      break;
+    case WCS_COMMAND_SAVE_PAGE:
+      ExecuteBrowserCommand(IDC_SAVE_PAGE);
+      break;
+    case WCS_COMMAND_ZOOM_IN:
+      ExecuteBrowserCommand(IDC_ZOOM_PLUS);
+      break;
+    case WCS_COMMAND_ZOOM_OUT:
+      ExecuteBrowserCommand(IDC_ZOOM_MINUS);
+      break;
+    case WCS_COMMAND_ZOOM_RESET:
+      ExecuteBrowserCommand(IDC_ZOOM_NORMAL);
+      break;
+    case WCS_COMMAND_TOGGLE_FULLSCREEN:
+      ExecuteBrowserCommand(IDC_FULLSCREEN);
+      break;
+    case WCS_COMMAND_OPEN_ABOUT:
+      ExecuteBrowserCommand(IDC_ABOUT);
+      break;
+    case WCS_COMMAND_EXIT:
+      ExecuteBrowserCommand(IDC_EXIT);
+      break;
+    case WCS_COMMAND_SET_RESTORE_ON_STARTUP: {
+      Profile* profile = browser_->profile();
+      if (!SessionStartupPref::TypeIsManaged(profile->GetPrefs())) {
+        const SessionStartupPref current =
+            SessionStartupPref::GetStartupPref(profile);
+        const bool keep_urls = current.ShouldOpenUrls();
+        SessionStartupPref replacement(
+            event_flags ? (keep_urls ? SessionStartupPref::LAST_AND_URLS
+                                     : SessionStartupPref::LAST)
+                        : (keep_urls ? SessionStartupPref::URLS
+                                     : SessionStartupPref::DEFAULT));
+        replacement.urls = current.urls;
+        SessionStartupPref::SetStartupPref(profile, replacement);
+        SyncState();
+      }
+      break;
+    }
+    case WCS_COMMAND_OPEN_SEARCH_SETTINGS:
+      OpenInternalPage(GURL("chrome://settings/search"));
+      break;
+  }
+}
