+void PopulateWinUiContextMenu(std::vector<WcsContextMenuItem>* items,
+                              std::vector<std::wstring>* labels,
+                              const ui::MenuModel* model,
+                              int32_t parent_index) {
+  for (size_t index = 0; index < model->GetItemCount(); ++index) {
+    if (!model->IsVisibleAt(index)) {
+      continue;
+    }
+    const ui::MenuModel::ItemType type = model->GetTypeAt(index);
+    if (type == ui::MenuModel::TYPE_BUTTON_ITEM) {
+      continue;
+    }
+
+    WcsContextMenuItem item{};
+    item.size = sizeof(item);
+    item.command_id = model->GetCommandIdAt(index);
+    item.parent_index = parent_index;
+    item.enabled = model->IsEnabledAt(index) &&
+                   type != ui::MenuModel::TYPE_TITLE;
+    item.checked =
+        (type == ui::MenuModel::TYPE_CHECK ||
+         type == ui::MenuModel::TYPE_RADIO) &&
+        model->IsItemCheckedAt(index);
+    if (type == ui::MenuModel::TYPE_SEPARATOR) {
+      item.type = WCS_CONTEXT_MENU_SEPARATOR;
+    } else if (type == ui::MenuModel::TYPE_SUBMENU ||
+               type == ui::MenuModel::TYPE_ACTIONABLE_SUBMENU) {
+      item.type = WCS_CONTEXT_MENU_SUBMENU;
+    } else if (type == ui::MenuModel::TYPE_CHECK) {
+      item.type = WCS_CONTEXT_MENU_CHECK;
+    } else if (type == ui::MenuModel::TYPE_RADIO) {
+      item.type = WCS_CONTEXT_MENU_RADIO;
+    } else {
+      item.type = WCS_CONTEXT_MENU_COMMAND;
+    }
+
+    const int32_t item_index = static_cast<int32_t>(items->size());
+    items->push_back(item);
+    labels->push_back(base::UTF16ToWide(model->GetLabelAt(index)));
+    if (type == ui::MenuModel::TYPE_SUBMENU ||
+        type == ui::MenuModel::TYPE_ACTIONABLE_SUBMENU) {
+      if (const ui::MenuModel* submenu_model =
+              model->GetSubmenuModelAt(index)) {
+        PopulateWinUiContextMenu(items, labels, submenu_model, item_index);
+      }
+    }
+  }
+}
+
+int RunWinUiContextMenu(HWND owner,
+                        const gfx::Point& screen_point,
+                        const ui::MenuModel* model) {
+  const auto shell = reinterpret_cast<WcsShellHandle>(
+      GetPropW(owner, L"CurveBrowserNativeShellActive"));
+  HMODULE module = GetModuleHandleW(L"curve_browser_shell.dll");
+  if (!shell || !module) {
+    return -1;
+  }
+  using ShowContextMenuFn = int32_t(__stdcall*)(
+      WcsShellHandle, const WcsContextMenuItem*, size_t, int32_t, int32_t);
+  const auto show_context_menu = reinterpret_cast<ShowContextMenuFn>(
+      GetProcAddress(module, "WcsShowContextMenu"));
+  if (!show_context_menu) {
+    return -1;
+  }
+
+  std::vector<WcsContextMenuItem> items;
+  std::vector<std::wstring> labels;
+  PopulateWinUiContextMenu(&items, &labels, model, -1);
+  for (size_t index = 0; index < items.size(); ++index) {
+    items[index].label = labels[index].c_str();
+  }
+  return show_context_menu(shell, items.data(), items.size(),
+                           screen_point.x(), screen_point.y());
+}
